# Meta Marketing API — system user token del Business Manager centralizzato ALC
META_ACCESS_TOKEN=
META_API_VERSION=v21.0

# Google Sheets — OAuth2 con il tuo account Google (client "Desktop app" + refresh token,
# ottenuto con scripts/get-refresh-token.js — vedi README)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
SHEET_ID=

# Google Drive — hand-off commerciale (creazione automatica cartella prospect + upload PDF report,
# vedi drive.ts): stesso account/refresh token di Sheets sopra, ma il refresh token va rigenerato
# includendo anche lo scope drive (vedi README). Id dello shared drive "COMMERCIALE ANDREA LENZI
# CONSULTING" (non l'id di una sua sottocartella) — apri lo shared drive nel browser e prendi l'id
# dall'URL: https://drive.google.com/drive/folders/<questo>.
GOOGLE_DRIVE_COMMERCIALE_ID=

# Auth team interno
TEAM_PASSWORD=
SESSION_SECRET=

# Protezione endpoint cron (Vercel invia automaticamente Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Estrazione meeting (tab Meeting) — scraping Fathom/Circleback/Loom + Groq
GROQ_API_KEY=gsk_...                          # console.groq.com/keys
CHROMIUM_PACK_URL=                            # opzionale, override binario chromium serverless
CHROME_EXECUTABLE_PATH=                       # obbligatorio in sviluppo locale, es. percorso di Chrome installato

# Foglio esterno "Report Operatività Clienti" (fuori da questo Sheet) — scrittura in parallelo
# allo storico MeetingCliente interno, stesso account OAuth2 sopra (nessuna condivisione ulteriore
# necessaria se l'account ha già accesso al foglio). Se non configurata, la scrittura viene
# semplicemente saltata (non blocca il salvataggio del meeting).
REPORT_OPERATIVITA_SHEET_ID=
REPORT_OPERATIVITA_TAB_NAME=                  # opzionale, default "Risposte del modulo 1"

# Invio email automatico follow-up meeting — Gmail API con delega a livello di dominio (Google
# Workspace): un service account impersona l'indirizzo del consulente assegnato al cliente per
# inviare "da" la sua vera casella. Setup una tantum (vedi README): service account in Google
# Cloud Console, delega di dominio abilitata, Client ID autorizzato in Workspace Admin Console
# con scope gmail.send. Se non configurata, l'invio automatico fallisce in modo pulito (non
# bloccante) — resta sempre disponibile il flusso manuale (scarica PDF / copia email).
GMAIL_SERVICE_ACCOUNT_EMAIL=
GMAIL_SERVICE_ACCOUNT_PRIVATE_KEY=            # chiave PEM su una riga con \n letterali

# Database Postgres su Supabase — sostituisce il foglio Google come archivio dell'app (passaggio in
# corso, ottobre 2026). È la stringa di connessione che Supabase mostra in "Connect": usare quella del
# "Transaction pooler" (porta 6543), con la password del database al suo interno. Solo lato server:
# non va mai in una variabile NEXT_PUBLIC_.
DATABASE_URL=

# Dove l'app legge e scrive i suoi dati (vedi src/lib/archivio.ts): `database` = Postgres su Supabase,
# qualunque altro valore o nessuno = il foglio Google. Dal 07/10/2026 la produzione è sul database e
# il foglio è fermo a quella data: NON rilanciare scripts/copia-foglio-nel-database.ts --sovrascrivi,
# cancellerebbe tutto ciò che è stato scritto da allora.
#
# Per provare l'app in locale senza toccare i dati veri c'è il database di prova, una copia in memoria
# (scripts/database-di-prova.ts, che spiega come avviarlo e come puntarci l'app).
ARCHIVIO_DATI=
